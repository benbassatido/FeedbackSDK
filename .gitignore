# ──────────────────────────────────────────────
# Root .gitignore — applies to the whole repo.
# Each subproject (FeedbackSDKProject, server, client)
# also has its own .gitignore for stack-specific files.
# ──────────────────────────────────────────────

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Linux
*~

# Editors / IDEs
.vscode/
.idea/
*.iml
*.swp
*.swo

# Logs & temp
*.log
*.tmp

# Environment files (never commit secrets).
# A committed *.env.example documents the required keys.
.env
.env.*
!.env.example
