<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.FeedbackSDK" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/fb_primary</item>
        <item name="colorPrimaryVariant">@color/fb_primary_dark</item>
        <item name="colorOnPrimary">@color/fb_on_primary</item>
        <item name="colorSecondary">@color/fb_primary</item>
        <item name="colorSecondaryVariant">@color/fb_primary_dark</item>
        <item name="colorOnSecondary">@color/fb_on_primary</item>

        <item name="android:colorBackground">@color/fb_background</item>
        <item name="colorSurface">@color/fb_surface</item>
        <item name="colorOnSurface">@color/fb_on_surface</item>
        <item name="colorOnBackground">@color/fb_on_surface</item>

        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.FeedbackSDK.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.FeedbackSDK.Medium</item>

        <item name="android:statusBarColor">@color/fb_background</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="ShapeAppearance.FeedbackSDK.Small" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">14dp</item>
    </style>

    <style name="ShapeAppearance.FeedbackSDK.Medium" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>

    <style name="Widget.FeedbackSDK.Toolbar.Title" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textColor">@color/fb_on_surface</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.FeedbackSDK.Button" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">16dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">16dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="elevation">3dp</item>
    </style>

</resources>
